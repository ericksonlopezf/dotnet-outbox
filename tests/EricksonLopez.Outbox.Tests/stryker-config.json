{
  "stryker-config": {
    "concurrency": 8,
    "thresholds": {
      "high": 100,
      "low": 98,
      "break": 50
    },
    "project": "EricksonLopez.Outbox.csproj",
    "mutate": [
      "**/*.cs",
      "!**/Testing/**/*.cs",
      "!**/*.g.cs",
      "!**/Generated/**/*.cs"
    ],
    "reporters": [
      "html",
      "json",
      "cleartext",
      "progress"
    ],
    "ignore-mutations": [],
    "ignore-methods": [
      "Log*",
      "LogDebug",
      "LogInformation",
      "LogWarning",
      "LogError",
      "PollerError",
      "BatchFetched",
      "ReclaimedStaleMessages",
      "PayloadTooLarge",
      "HeadersTooLarge",
      "HeadersDeserializeFailed",
      "MessageDispatched",
      "MessageDispatchFailed",
      "StartupValidationFailed",
      "StartupValidationPassed",
      "ProducerOnlyMode",
      "ThirdPartyDeadLetterRepositoryRegistered",
      "ConfigureAwait",
      "ReturnArrayToPool",
      "RecordMetrics",
      "RecordMessageDispatched"
    ]
  }
}
