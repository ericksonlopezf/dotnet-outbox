{
  "stryker-config": {
    "concurrency": 8,
    "thresholds": {
      "high": 100,
      "low": 98,
      "break": 95
    },
    "project": "EricksonLopez.Outbox.EntityFrameworkCore.csproj",
    "mutate": [
      "**/*.cs"
    ],
    "reporters": [
      "cleartext",
      "progress",
      "json"
    ],
    "ignore-mutations": [
      "string"
    ],
    "ignore-methods": [
      "Log*",
      "LogDebug",
      "LogInformation",
      "LogWarning",
      "LogError",
      "ConfigureAwait"
    ]
  }
}
