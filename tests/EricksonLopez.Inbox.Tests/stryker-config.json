{
  "stryker-config": {
    "concurrency": 6,
    "thresholds": {
      "high": 100,
      "low": 98,
      "break": 95
    },
    "project": "EricksonLopez.Inbox.csproj",
    "mutate": [
      "**/*.cs",
      "!**/*.g.cs",
      "!**/Generated/**/*.cs"
    ],
    "reporters": [
      "html",
      "json",
      "cleartext",
      "progress"
    ],
    "ignore-mutations": [],
    "ignore-methods": [
      "Log*",
      "ConfigureAwait"
    ]
  }
}
