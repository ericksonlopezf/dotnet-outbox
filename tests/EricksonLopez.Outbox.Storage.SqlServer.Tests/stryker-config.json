{
  "stryker-config": {
    "concurrency": 1,
    "additional-timeout": 30000,
    "coverage-analysis": "all",
    "thresholds": {
      "high": 100,
      "low": 98,
      "break": 95
    },
    "project": "EricksonLopez.Outbox.Storage.SqlServer.csproj",
    "mutate": [
      "**/*.cs",
      "!**/*.g.cs",
      "!**/Generated/**/*.cs"
    ],
    "reporters": [
      "html",
      "json",
      "cleartext",
      "progress"
    ],
    "ignore-mutations": [],
    "ignore-methods": [
      "Log*",
      "ConfigureAwait"
    ]
  }
}
