<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Source Generators for EricksonLopez.Outbox. Delivers high-performance, Zero-Reflection, NativeAOT-ready compile-time code generation for the transactional outbox pattern.</Description>
    <PackageTags>$(PackageTags);source-generator;roslyn;csharp;codegen</PackageTags>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- CS8622: Known Roslyn nullability quirk with IncrementalValuesProvider Collect()
         RS1032: False-positive about DiagnosticDescriptor Ã¢â‚¬â€ not applicable to pure source generators. -->
    <NoWarn>$(NoWarn);CS8622;RS1032</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- RS2008: AnalyzerReleases files must be declared as AdditionalFiles so the
         Roslyn tooling picks them up for diagnostic history display in IDEs and nuget.org.
         IMPORTANT: filenames must be exactly AnalyzerReleases.Shipped.md and
         AnalyzerReleases.Unshipped.md (case-sensitive). -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
