<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>[INTEROP / COMPATIBILITY BRIDGE] MediatR integration for EricksonLopez.Outbox. Enables transparent out-of-process durability for INotification publishers.</Description>
    <PackageTags>$(CommonPackageTags);mediatr;cqrs;notification-publisher;domain-events;event-driven</PackageTags>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <!-- MediatR relies on runtime reflection; AOT and Trimming are not supported -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Outbox\EricksonLopez.Outbox.csproj" />
  </ItemGroup>

</Project>
