<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>EricksonLopez.Mediator integration for EricksonLopez.Outbox. Enables transparent durability and outbox storage for in-process mediator notifications and pipeline commands.</Description>
    <PackageTags>$(CommonPackageTags);mediator;cqrs;in-process;events;native-aot</PackageTags>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Outbox\EricksonLopez.Outbox.csproj" />
    <ProjectReference Include="..\..\..\dotnet-mediator\src\EricksonLopez.Mediator\EricksonLopez.Mediator.csproj" 
                      Condition="Exists('..\..\..\dotnet-mediator\src\EricksonLopez.Mediator\EricksonLopez.Mediator.csproj')" />
    <PackageReference Include="EricksonLopez.Mediator" 
                      Condition="!Exists('..\..\..\dotnet-mediator\src\EricksonLopez.Mediator\EricksonLopez.Mediator.csproj')" />
  </ItemGroup>
</Project>
