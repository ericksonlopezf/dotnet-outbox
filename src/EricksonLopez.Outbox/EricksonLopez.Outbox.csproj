<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Core library for EricksonLopez.Outbox. Provides a modern, high-performance, Zero-Reflection, NativeAOT-ready implementation of the transactional outbox pattern for .NET.</Description>
    <!-- ISSUE-PKG3: Multi-targeting policy (reviewed 2026-08):
         Framework versions follow the official Microsoft .NET Support Policy:
         https://dotnet.microsoft.com/platform/support/policy/dotnet-core
         net9.0 is included for its full 24-month STS window and will be removed
         after its official EOL date, not before.
         - net8.0: LTS (EOL November 10, 2026) — keep until EOL
         - net9.0: STS (EOL November 10, 2026) — keep until EOL; 24-month support window per updated Microsoft policy
         - net10.0: LTS (EOL November 2028) — included since GA release
         Next review: November 2026. Both net8.0 and net9.0 EOL on same date.
         At that point, drop both and add net9.0 was never "May 2026" — that was an earlier
         draft STS estimate before Microsoft updated the STS window to 24 months. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageTags>$(CommonPackageTags);native-aot;messaging;event-driven;reliability;resilience;dual-write;distributed-systems</PackageTags>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Outbox.Abstractions\EricksonLopez.Outbox.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EricksonLopez.Result" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.Outbox.Tests" />
    <InternalsVisibleTo Include="EricksonLopez.Outbox.AotTests" />
    <InternalsVisibleTo Include="EricksonLopez.Outbox.Storage.PostgreSql.Tests" />
  </ItemGroup>

</Project>
