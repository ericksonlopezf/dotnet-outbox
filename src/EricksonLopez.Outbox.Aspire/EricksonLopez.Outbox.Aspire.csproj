<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>.NET Aspire integration component for EricksonLopez.Outbox. Provides seamless registration, OpenTelemetry telemetry wiring, and health checks for Aspire applications.</Description>
    <PackageTags>$(CommonPackageTags);aspire;cloud-native;opentelemetry;health-checks;native-aot</PackageTags>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Outbox\EricksonLopez.Outbox.csproj" />
  </ItemGroup>

</Project>
