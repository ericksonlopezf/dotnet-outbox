<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Outbox\EricksonLopez.Outbox.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit" />
  </ItemGroup>

  <PropertyGroup>
    <Description>[INTEROP / COMPATIBILITY BRIDGE] MassTransit integration for EricksonLopez.Outbox. Enables reliable event publishing through MassTransit pipelines.</Description>
    <PackageTags>$(CommonPackageTags);masstransit;message-bus;messaging;event-driven;publish-subscribe</PackageTags>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <!-- MassTransit relies on runtime reflection, dynamic dispatch, and Expression trees; AOT is not supported -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

</Project>
