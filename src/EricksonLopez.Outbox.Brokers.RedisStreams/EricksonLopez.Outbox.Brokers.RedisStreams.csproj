<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Redis Streams message broker transport for EricksonLopez.Outbox. Delivers high-performance, Zero-Reflection, NativeAOT-ready event publishing to Redis Streams.</Description>
    <PackageTags>$(CommonPackageTags);outbox;transactional-outbox;redis;redis-streams;message-broker;event-streaming;native-aot</PackageTags>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Outbox\EricksonLopez.Outbox.csproj" />
  </ItemGroup>

</Project>
