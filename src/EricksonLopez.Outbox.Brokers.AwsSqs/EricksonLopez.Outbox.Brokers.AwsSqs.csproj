<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>AWS SQS message broker transport for EricksonLopez.Outbox. Delivers high-performance, Zero-Reflection, NativeAOT-ready event publishing to Amazon SQS.</Description>
    <PackageTags>$(CommonPackageTags);aws;aws-sqs;amazon-sqs;cloud-messaging;native-aot</PackageTags>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SQS" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Outbox\EricksonLopez.Outbox.csproj" />
  </ItemGroup>

</Project>
