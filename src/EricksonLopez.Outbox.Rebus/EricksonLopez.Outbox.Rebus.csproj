<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>[INTEROP / COMPATIBILITY BRIDGE] Rebus integration for EricksonLopez.Outbox. Provides reliable transactional outbox publishing within Rebus pipelines.</Description>
    <PackageTags>$(CommonPackageTags);rebus;message-bus;messaging;service-bus;publish-subscribe</PackageTags>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <!-- Rebus relies on runtime reflection and dynamic handler resolution; AOT is not supported -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rebus" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Outbox\EricksonLopez.Outbox.csproj" />
  </ItemGroup>

</Project>
