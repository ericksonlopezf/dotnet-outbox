<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Protocol Buffers (Protobuf-net) binary serialization provider for EricksonLopez.Outbox. Provides high-throughput, compact binary serialization.</Description>
    <PackageTags>$(CommonPackageTags);protobuf;protocol-buffers;serialization;binary;native-aot</PackageTags>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="protobuf-net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Outbox\EricksonLopez.Outbox.csproj" />
  </ItemGroup>

</Project>
