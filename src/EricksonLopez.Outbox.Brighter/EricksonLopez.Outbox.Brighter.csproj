<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>[INTEROP / COMPATIBILITY BRIDGE] Paramore.Brighter integration for EricksonLopez.Outbox. Enables transactional outbox message production for Brighter command processors.</Description>
    <PackageTags>$(CommonPackageTags);brighter;command-processor;cqrs;messaging;event-driven</PackageTags>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <!-- Paramore.Brighter relies on runtime reflection and dynamic handler routing; AOT is not supported -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Paramore.Brighter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Outbox\EricksonLopez.Outbox.csproj" />
  </ItemGroup>

</Project>
