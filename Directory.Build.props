<!-- Copyright © Erickson Lopez. MIT License. -->
<Project>

  <PropertyGroup>
    <VersionPrefix>2.0.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>

    <!-- NuGet package metadata -->
    <Authors>Erickson Lopez</Authors>
    <Company>Erickson Lopez</Company>
    <Copyright>Copyright © Erickson Lopez. MIT License.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://ericksonlopez.dev/outbox</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ericksonlopezf/dotnet-outbox</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <CommonPackageTags>dotnet;csharp;outbox;transactional-outbox</CommonPackageTags>
    <PackageTags>$(CommonPackageTags)</PackageTags>
    <Description>High-performance, Zero-Reflection, NativeAOT-ready Transactional Outbox pattern implementation for .NET.</Description>
    <PackageReleaseNotes>https://github.com/ericksonlopezf/dotnet-outbox/releases</PackageReleaseNotes>

    <!-- Build settings -->
    <LangVersion>latest</LangVersion>
    <IsAotCompatible Condition="!$(MSBuildProjectName.Contains('Tests')) And !$(MSBuildProjectName.Contains('Analyzers')) And !$(MSBuildProjectName.Contains('SourceGenerators')) And !$(MSBuildProjectName.Contains('Benchmarks')) And !$(MSBuildProjectName.Contains('Sample'))">true</IsAotCompatible>
    <IsTrimmable Condition="'$(IsAotCompatible)' == 'true'">true</IsTrimmable>
    <EnableTrimAnalyzer Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0')) and '$(IsAotCompatible)' == 'true'">true</EnableTrimAnalyzer>
    <EnableAotAnalyzer Condition="'$(IsAotCompatible)' == 'true'">true</EnableAotAnalyzer>
    <PublishReadyToRun>true</PublishReadyToRun>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1716;CA1062;CA1711;CA1068</NoWarn>
    <!-- ADR-030: Roy Osherove naming standard (Method_Scenario_Result) and BenchmarkDotNet runner method naming -->
    <NoWarn Condition="$(MSBuildProjectName.Contains('Tests')) Or $(MSBuildProjectName.Contains('Benchmarks'))">$(NoWarn);IDE1006;CA1707;IL2026;IL3050</NoWarn>

    <GenerateDocumentationFile Condition="!$(MSBuildProjectDirectory.Contains('tests')) and !$(MSBuildProjectDirectory.Contains('benchmarks')) and !$(MSBuildProjectDirectory.Contains('samples'))">true</GenerateDocumentationFile>

    
    <!-- Strong Naming -->
    <SignAssembly Condition="Exists('$(MSBuildThisFileDirectory)EricksonLopez.snk')">true</SignAssembly>
    <AssemblyOriginatorKeyFile Condition="Exists('$(MSBuildThisFileDirectory)EricksonLopez.snk')">$(MSBuildThisFileDirectory)EricksonLopez.snk</AssemblyOriginatorKeyFile>
    <PublicKey Condition="'$(SignAssembly)' == 'true'"></PublicKey>
    <DefineConstants Condition="'$(SignAssembly)' == 'true'">$(DefineConstants);SIGN_ASSEMBLY</DefineConstants>

    <!-- Deterministic builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- SourceLink -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Security -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <MinClientVersion>6.0.0</MinClientVersion>

    <!-- Package Validation -->
    <EnablePackageValidation Condition="'$(IsPackable)' == 'true'">true</EnablePackageValidation>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(SignAssembly)' == 'true'">
    <InternalsVisibleTo>
      <Key>$(PublicKey)</Key>
    </InternalsVisibleTo>
  </ItemDefinitionGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Project-specific readme takes precedence if present, otherwise root readme.md mapped to README.md in package -->
    <None Include="$(MSBuildProjectDirectory)/readme.md" Pack="true" PackagePath="README.md" Condition="Exists('$(MSBuildProjectDirectory)/readme.md')" />
    <None Include="$(MSBuildThisFileDirectory)readme.md" Pack="true" PackagePath="README.md" Condition="!Exists('$(MSBuildProjectDirectory)/readme.md') and Exists('$(MSBuildThisFileDirectory)readme.md')" />

    <!-- Project-specific icon.png takes precedence if present, otherwise fallback to root or docs icon -->
    <None Include="$(MSBuildProjectDirectory)/icon.png" Pack="true" PackagePath="icon.png" Condition="Exists('$(MSBuildProjectDirectory)/icon.png')" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="icon.png" Condition="!Exists('$(MSBuildProjectDirectory)/icon.png') and Exists('$(MSBuildThisFileDirectory)icon.png')" />
    <None Include="$(MSBuildThisFileDirectory)docs/icon.png" Pack="true" PackagePath="icon.png" Link="icon.png" Condition="!Exists('$(MSBuildProjectDirectory)/icon.png') and !Exists('$(MSBuildThisFileDirectory)icon.png') and Exists('$(MSBuildThisFileDirectory)docs/icon.png')" />
  </ItemGroup>
</Project>
