<Project>

  <PropertyGroup>
    <VersionPrefix>1.0.1</VersionPrefix>
    <VersionSuffix/>

    <!-- NuGet package metadata -->
    <Authors>Erickson López</Authors>
    <Company>EricksonLopez</Company>
    <Copyright>Copyright © 2026 Erickson López</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ericksonlopezf/dotnet-outbox</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ericksonlopezf/dotnet-outbox</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>transactional-outbox;outbox-pattern;at-least-once;nativeaot;aot;zero-reflection;high-performance</PackageTags>
    <Description>High-performance, Zero-Reflection, NativeAOT-ready Transactional Outbox pattern implementation for .NET.</Description>
    <PackageReleaseNotes>https://github.com/ericksonlopezf/dotnet-outbox/releases</PackageReleaseNotes>
    <!-- Build settings -->
    <LangVersion>latest</LangVersion>
    <IsAotCompatible Condition="!$(MSBuildProjectName.Contains('Tests')) And !$(MSBuildProjectName.Contains('Analyzers')) And !$(MSBuildProjectName.Contains('SourceGenerators')) And !$(MSBuildProjectName.Contains('Benchmarks')) And !$(MSBuildProjectName.Contains('Sample'))">true</IsAotCompatible>
    <IsTrimmable Condition="'$(IsAotCompatible)' == 'true'">true</IsTrimmable>
    <EnableTrimAnalyzer Condition="'$(IsAotCompatible)' == 'true'">true</EnableTrimAnalyzer>
    <EnableAotAnalyzer Condition="'$(IsAotCompatible)' == 'true'">true</EnableAotAnalyzer>
    <PublishReadyToRun>true</PublishReadyToRun>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1716;CA1062;CA1707;CA1711;CA1068</NoWarn>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
    <!-- Strong Naming -->
    <SignAssembly Condition="Exists('$(MSBuildThisFileDirectory)EricksonLopez.snk')">true</SignAssembly>
    <AssemblyOriginatorKeyFile Condition="Exists('$(MSBuildThisFileDirectory)EricksonLopez.snk')">$(MSBuildThisFileDirectory)EricksonLopez.snk</AssemblyOriginatorKeyFile>

    <!-- Deterministic builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- SourceLink -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Security -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <MinClientVersion>6.0.0</MinClientVersion>

    <!-- ISSUE-BIN1: PackageValidationBaselineVersion — ACTIVATE AFTER FIRST NUGET PUBLISH
         
         CURRENT STATUS: Commented out (pre-release). No published baseline exists yet.
         
         HOW TO ACTIVATE (do this immediately after publishing v1.0.0 to NuGet.org):
           1. Confirm the package is live: https://www.nuget.org/packages/EricksonLopez.Outbox/1.0.0
           2. Uncomment the XML element below and set the value to your published version:
              <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
           3. Commit and push. From this point forward, every build automatically validates
              that the public API surface is backwards-compatible with the 1.0.0 baseline.
         
         WHY THIS MATTERS:
           Package Validation runs 'Microsoft.DotNet.ApiCompat' on every build/pack and fails
           with a clear error if you:
             - Remove a public method, property, or type
             - Change a method signature (parameter type, return type)
             - Add a required interface member without a default implementation
             - Change a type's base class or implemented interfaces
           Binary breaking changes silently crash consumers at runtime. This check makes them
           compile-time failures — consistent with the library's "fail fast" philosophy.
         
         REFERENCE: https://learn.microsoft.com/en-us/dotnet/fundamentals/package-validation/baseline-version-validator
         SUPPRESS FALSE POSITIVES: Add to .editorconfig or create CompatibilitySuppressions.xml
    -->
    <!-- <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion> -->
    <EnablePackageValidation Condition="'$(IsPackable)' == 'true'">true</EnablePackageValidation>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All"/>
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\"/>
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
