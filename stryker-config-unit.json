{
  "stryker-config": {
    "thresholds": {
      "high": 100,
      "low": 98,
      "break": 95
    },
    "solution": "EricksonLopez.Outbox.slnx",
    "mutate": [
      "!**/Testing/**/*.cs",
      "!**/*.g.cs",
      "!**/Generated/**/*.cs",
      "!**/EricksonLopez.Outbox.Analyzers/**/*.cs",
      "!**/*Analyzer.cs",
      "!**/*CodeFixProviders.cs"
    ],
    "test-projects": [
      "EricksonLopez.Outbox.Tests.csproj"
    ],
    "reporters": [
      "html",
      "json",
      "cleartext",
      "progress"
    ],
    "ignore-mutations": [
      "Initializer",
      "String"
    ],
    "ignore-methods": [
      "*Log*",
      "*Trace*",
      "*Debug*",
      "*Exception*",
      "ThrowIf*",
      "ConfigureAwait",
      "Dispose",
      "ToString",
      "GetHashCode",
      "Equals"
    ]
  }
}
